      attribute "ocaml.doc"
        [
          structure_item (lambda/lambda.mli[386,13255+0]..[397,13677+3])
            Pstr_eval
            expression (lambda/lambda.mli[386,13255+0]..[397,13677+3])
              Pexp_constant PConst_string(" [subst update_env ?freshen_bound_variables s lt]\n    applies a substitution [s] to the lambda-term [lt].\n\n    Assumes that the image of the substitution is out of reach\n    of the bound variables of the lambda-term (no capture).\n\n    [update_env] is used to refresh the environment contained in debug\n    events.\n\n    [freshen_bound_variables], which defaults to [false], freshens\n    the bound variables within [lt].\n ",(lambda/lambda.mli[386,13255+0]..[397,13677+3]),None)
        ]
      core_type (lambda/lambda.mli[383,13119+2]..[385,13214+40])
