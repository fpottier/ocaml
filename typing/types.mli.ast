              (typing/types.mli[83,3610+2]..[83,3610+63])
                "Tobject" (typing/types.mli[83,3610+4]..[83,3610+11])
                attribute "ocaml.doc"
                  [
                    structure_item (typing/types.mli[84,3674+2]..[100,4356+4])
                      Pstr_eval
                      expression (typing/types.mli[84,3674+2]..[100,4356+4])
                        Pexp_constant PConst_string(" [Tobject (`f1:t1;...;fn: tn', `None')] ==> [< f1: t1; ...; fn: tn >]\n      f1, fn are represented as a linked list of types using Tfield and Tnil\n      constructors.\n\n      [Tobject (_, `Some (`A.ct', [t1;...;tn]')] ==> [(t1, ..., tn) A.ct].\n      where A.ct is the type of some class.\n\n      There are also special cases for so-called \"class-types\", cf. [Typeclass]\n      and [Ctype.set_object_name]:\n\n        [Tobject (Tfield(_,_,...(Tfield(_,_,rv)...),\n                         Some(`A.#ct`, [rv;t1;...;tn])]\n             ==> [(t1, ..., tn) #A.ct]\n        [Tobject (_, Some(`A.#ct`, [Tnil;t1;...;tn])] ==> [(t1, ..., tn) A.ct]\n\n      where [rv] is the hidden row variable.\n  ",(typing/types.mli[84,3674+2]..[100,4356+4]),None)
                  ]
